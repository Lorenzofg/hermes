# Database
DB_USER=hermes
DB_PASSWORD=change_me
DB_NAME=hermes

# Auth — each user configures their own AI provider keys/models after
# logging in (Settings screen), so there are no server-wide AI env vars.
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_char_hex_string
ENCRYPTION_KEY=replace_with_a_different_random_64_char_hex_string

# App
FRONTEND_URL=https://yourdomain.com
WEB_PORT=80
